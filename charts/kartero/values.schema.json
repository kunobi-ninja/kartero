{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "required": ["repository", "pullPolicy"]
    },
    "github": {
      "type": "object",
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "workflows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "artifactPrefix": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string", "minLength": 1 },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      },
      "required": ["owner", "repo", "workflows", "artifactPrefix", "existingSecret", "existingSecretKey"]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "minLength": 1 },
          "workflows": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "trustedBranch": { "type": "string", "minLength": 1 },
          "actions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "gateJob": { "type": "string", "minLength": 1 },
              "guardJob": { "type": "string", "minLength": 1 },
              "guardStep": { "type": "string", "minLength": 1 },
              "filterJob": { "type": "string", "minLength": 1 },
              "docsJob": { "type": "string", "minLength": 1 },
              "branchClasses": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
              "jobAliases": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
              "canonicalJobs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "jobNamesArtifact": { "type": "string", "minLength": 1 },
              "excludedWorkflows": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "required": ["gateJob", "guardJob", "guardStep", "filterJob", "docsJob"]
          },
          "existingSecret": { "type": "string", "minLength": 1 },
          "existingSecretKey": { "type": "string", "minLength": 1 }
        },
        "required": ["owner", "repo", "workflows", "existingSecret", "existingSecretKey"]
      }
    },
    "allowlist": {
      "type": "object",
      "properties": {
        "mountPath": { "type": "string", "minLength": 1 },
        "content": { "type": "string" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "mountPath": { "type": "string", "minLength": 1 }
      },
      "required": ["mountPath"]
    },
    "otlp": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string", "minLength": 1 }
      },
      "required": ["endpoint"]
    },
    "interval": { "type": "string", "minLength": 1 },
    "heartbeatInterval": { "type": "string", "minLength": 1 },
    "ledger": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["ephemeral", "pvc"] },
            "mountPath": { "type": "string", "minLength": 1 },
            "size": { "type": "string", "minLength": 1 },
            "storageClassName": { "type": "string" },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "required": ["type", "mountPath", "size", "accessModes"]
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "signoz": {
      "type": "object",
      "properties": {
        "scrape": { "type": "boolean" },
        "path": { "type": "string" }
      }
    },
    "archive": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "artifactPrefix": { "type": "string", "minLength": 1 },
        "maxBytes": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "minLength": 1 },
        "persistence": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["ephemeral", "pvc"] },
            "size": { "type": "string", "minLength": 1 },
            "storageClassName": { "type": "string" },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
