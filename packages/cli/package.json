{
  "name": "@kunobi/kartero",
  "version": "0.3.0",
  "description": "Generate validated Kartero OTLP artifacts from CI reports.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/kunobi-ninja/kartero#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunobi-ninja/kartero.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/kunobi-ninja/kartero/issues"
  },
  "bin": {
    "kartero": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/cli.js",
    "dist/coverage.js",
    "dist/coverage.d.ts",
    "dist/gauge.js",
    "dist/gauge.d.ts",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/validate.js",
    "dist/validate.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test dist/**/*.test.js",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
